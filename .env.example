# Same-origin browser session gateway. Backend origin, without /api.
BACKEND_URL=http://localhost:8080
# Public frontend origin. HTTPS is mandatory for npm start (production).
PUBLIC_ORIGIN=http://localhost:5173
# Generate 32 random bytes, Base64 encoded. Required in production; never VITE_ prefixed.
SESSION_ENCRYPTION_KEY=
# Durable encrypted session store; persist this directory across deployments.
SESSION_DATA_DIR=.session-data
# Public Google client ID (matches the backend).
VITE_GOOGLE_CLIENT_ID=
