  "components": {
    "schemas": {
      "UpdateReceiptDetailsRequest": {
        "type": "object",
        "properties": {
          "merchantName": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "purchaseDate": {
            "type": "string",
            "format": "date-time"
          },
          "discount": {
            "type": "number",
            "minimum": 0.0
          },
          "tax": {
            "type": "number",
            "minimum": 0.0
          },
          "fee": {
            "type": "number",
            "minimum": 0.0
          },
          "tip": {
            "type": "number",
            "minimum": 0.0
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "required": [
          "currency",
          "discount",
          "fee",
          "tax",
          "tip"
        ]
      },
      "ReceiptAdjustmentAllocationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "adjustmentType": {
            "type": "string"
          },
          "participantId": {
            "type": "integer",
            "format": "int64"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "amount": {
            "type": "number"
          }
        }
      },
      "ReceiptItemAllocationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "itemId": {
            "type": "integer",
